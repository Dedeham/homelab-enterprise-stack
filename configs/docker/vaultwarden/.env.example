# Vaultwarden environment variables
# Copy this to .env and fill in your values. Never commit .env to git!

# Your base domain
DOMAIN=example.com

# Admin token — generate HASHED value with:
# docker run --rm -it vaultwarden/server /vaultwarden hash
# Paste the HASH here (starting with $argon2id$ or $argon2i$)
VAULTWARDEN_ADMIN_TOKEN=generate_and_paste_hash_here

# SMTP for login alert emails (use Gmail App Password or Mailgun etc.)
SMTP_HOST=smtp.gmail.com
SMTP_USER=your@gmail.com
SMTP_PASSWORD=your_app_password
