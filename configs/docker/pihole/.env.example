# Pi-hole environment variables
# Copy this to .env and fill in your values. Never commit .env to git!
#
# HOW TO USE:
#   cp .env.example .env
#   nano .env            ← fill in your actual values
#   docker compose up -d

DOMAIN=example.com

# Your Docker VM IP address on the LAN.
# DNS port 53 is bound to this IP only (not all interfaces).
# This prevents Pi-hole from being an open DNS resolver if your server
# has any public-facing network interfaces.
# ← CHANGE THIS to your Docker VM's actual LAN IP
SERVER_IP=192.168.1.20

# Pi-hole web UI password
# Generate a strong one with: openssl rand -base64 24
PIHOLE_WEBPASSWORD=change_me_strong_password
