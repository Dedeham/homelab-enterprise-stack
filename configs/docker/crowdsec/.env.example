# CrowdSec environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains secrets!

# Bouncer API key — allows the Traefik bouncer to talk to the CrowdSec engine.
#
# To generate this key:
#   1. Make sure the CrowdSec engine is running:  docker compose up -d crowdsec
#   2. Run:  docker exec -it crowdsec cscli bouncers add bouncer-traefik
#   3. Copy the displayed key and paste it below.
#
# You only need to do this once. The key persists across container restarts.
CROWDSEC_BOUNCER_KEY=generate_with_cscli_bouncers_add
