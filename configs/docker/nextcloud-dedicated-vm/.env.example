# Nextcloud dedicated VM environment variables
# Copy this file to .env on the Nextcloud VM and fill in real values.
# Never commit .env to git.

# Base domain without https://
DOMAIN=example.com

# First-run admin account. After setup, changing these values does not reset
# the admin password.
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change_me_strong_password

# Database credentials. Generate strong random values with:
#   openssl rand -base64 32
NEXTCLOUD_DB_PASSWORD=change_me_db_password
NEXTCLOUD_DB_ROOT_PASSWORD=change_me_db_root_password

# Redis password for cache/file-lock authentication.
REDIS_PASSWORD=change_me_redis_password
