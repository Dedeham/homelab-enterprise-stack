# ──────────────────────────────────────────────────────────────────────
# Watchtower — Environment Variables
# ──────────────────────────────────────────────────────────────────────
#
# Copy this file to .env and fill in the values below:
#   cp .env.example .env
#
# ──────────────────────────────────────────────────────────────────────

# ── Discord Webhook URL ────────────────────────────────────────────
#
# ✅ How to create a Discord webhook:
#   1. Open your Discord server
#   2. Go to Server Settings → Integrations → Webhooks
#   3. Click "New Webhook"
#   4. Choose the channel where you want update notifications
#   5. (Optional) Give it a name like "Watchtower" and a custom avatar
#   6. Click "Copy Webhook URL" and paste it below
#
# ⚠️  Do NOT include the "/slack" suffix here — that's added
#     automatically in docker-compose.yml
#
# The URL format looks like:
#   https://discord.com/api/webhooks/123456789/ABCdef...
#
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token

# ── Telegram / Shoutrrr Notification URL ──────────────────────────
#
# Optional alternative to the Discord legacy webhook above.
#
# Create a Telegram bot with @BotFather, then generate the target URL:
#   docker run --rm -it containrrr/shoutrrr generate telegram
#
# Use this only after changing docker-compose.yml to:
#   - WATCHTOWER_NOTIFICATION_URL=${WATCHTOWER_NOTIFICATION_URL}
#
# Private chat or group example:
# WATCHTOWER_NOTIFICATION_URL=telegram://BOT_TOKEN@telegram?chats=CHAT_ID
#
# Public channel example:
# WATCHTOWER_NOTIFICATION_URL=telegram://BOT_TOKEN@telegram?chats=@your_channel_name
#
# Discord and Telegram together, using shoutrrr for both:
# WATCHTOWER_NOTIFICATION_URL=telegram://BOT_TOKEN@telegram?chats=CHAT_ID discord://DISCORD_WEBHOOK_TOKEN@DISCORD_WEBHOOK_ID
