# Nextcloud environment variables
# Copy this to .env and fill in your values. Never commit .env to git!
#
# HOW TO USE:
#   cp .env.example .env
#   nano .env            ← fill in your actual values
#   docker compose up -d

# Your base domain (without https://)
DOMAIN=example.com

# Nextcloud admin account — only used on the FIRST run.
# After the initial setup, changing these does nothing.
# Use a strong password — this protects your cloud storage.
NEXTCLOUD_ADMIN_USER=admin
NEXTCLOUD_ADMIN_PASSWORD=change_me_strong_password

# Database passwords — generate strong random ones with:
#   openssl rand -base64 32
# These connect Nextcloud to its MariaDB database.
NEXTCLOUD_DB_PASSWORD=change_me_db_password
NEXTCLOUD_DB_ROOT_PASSWORD=change_me_db_root_password

# Redis password — used for cache authentication (defense in depth).
# Generate with: openssl rand -base64 32
REDIS_PASSWORD=change_me_redis_password
