# Jellyfin environment variables
# Copy this to .env and fill in your values. Never commit .env to git!
#
# HOW TO USE:
#   cp .env.example .env
#   nano .env            ← fill in your actual values
#   docker compose up -d

# Your base domain (without https://)
DOMAIN=example.com

# User and Group ID — Jellyfin runs as this user inside the container.
# These MUST match the owner of your media files on the NFS mount.
#
# To find the correct values, run this on the Docker VM:
#   ls -ln /mnt/media/
# Look at the 3rd and 4th columns (UID and GID).
#
# Common values:
#   1000:1000 = default Debian user
#   568:568   = TrueNAS apps user
#   0:0       = root (not recommended)
PUID=1000
PGID=1000
