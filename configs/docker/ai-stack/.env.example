# AI Stack environment variables
# Copy this to .env and fill in your values. Never commit .env to git!

# Your base domain
DOMAIN=example.com
TZ=Europe/Berlin

# ── Whisper (speech-to-text) ─────────────────────────────────────────────────
# API key clients must send as "Authorization: Bearer <key>" — generate with: openssl rand -hex 32
WHISPER_API_KEY=change_me
# Model to download after first start (see docs/services/ai-stack.md). Good CPU choices:
#   Systran/faster-whisper-small            — fast, good quality (recommended start)
#   Systran/faster-whisper-medium           — better accuracy, ~2x slower
#   deepdml/faster-whisper-large-v3-turbo-ct2 — best accuracy, needs a strong CPU or GPU
WHISPER_MODEL=Systran/faster-whisper-small
WHISPER_MEMORY_LIMIT=3G
WHISPER_CPUS=2.0

# ── Vision model (llama.cpp) ─────────────────────────────────────────────────
# Hugging Face repo with a multimodal GGUF (model + mmproj). Append :<quant> to pick a quantization.
#   ggml-org/gemma-3-4b-it-GGUF              — ~4 GB RAM, solid CPU default
#   ggml-org/Qwen2.5-VL-3B-Instruct-GGUF     — ~3 GB RAM, good at OCR/documents
#   ggml-org/gemma-3-12b-it-GGUF             — ~10 GB RAM, noticeably better, slower
#   ggml-org/Llama-4-Scout-17B-16E-Instruct-GGUF — 60+ GB RAM, only for big servers/GPUs
VISION_HF_REPO=ggml-org/gemma-3-4b-it-GGUF
VISION_CTX_SIZE=8192
VISION_THREADS=4
VISION_MEMORY_LIMIT=8G
VISION_CPUS=4.0
# API key clients must send as "Authorization: Bearer <key>" — generate with: openssl rand -hex 32
VISION_API_KEY=change_me

# ── n8n ──────────────────────────────────────────────────────────────────────
# Generate both with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change_me
POSTGRES_PASSWORD=change_me
