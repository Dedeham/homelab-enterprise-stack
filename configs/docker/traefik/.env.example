# Traefik environment variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it contains secrets!

# Your Cloudflare API token for DNS challenge (create at: Cloudflare → My Profile → API Tokens)
# Use the "Edit zone DNS" template scoped to your domain only.
CF_DNS_API_TOKEN=your_cloudflare_api_token_here

# Your base domain, used by docker-compose.yml labels such as traefik.${DOMAIN}.
# Do not include https:// or a trailing slash.
DOMAIN=example.com
